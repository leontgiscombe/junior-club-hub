# Upstash Redis (Vercel KV): the hub's database. Vercel adds these when you
# connect an Upstash store to the project.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash-style names are picked up too.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Coach Admin password: the /admin page, kit responses, stats, match and
# training logs, and setting up a team in Financial Admin all use it. While
# it's unset, nobody can sign in.
ADMIN_KEY=

# Optional: a separate owner password for changing the drill library.
# TRAINING_PLANS_OWNER_KEY=

# Financial Admin's monthly reminders. Generate a pair at vapidkeys.com or
# with `npx web-push generate-vapid-keys`. CRON_SECRET stops anyone else
# triggering the reminders; VAPID_SUBJECT defaults to the site's address.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
# VAPID_SUBJECT=mailto:you@example.com

# Running as a platform for many clubs: the domain each club gets a
# subdomain of (riverside.grassroots-club-hub.co.uk). The root domain itself shows
# the platform's site: sign-up and find-your-club. Leave unset to run one
# club (its coach password is ADMIN_KEY above).
# ROOT_DOMAIN=grassroots-club-hub.co.uk
# PLATFORM_NAME=Grassroots Club Hub

# Email (password resets, welcome emails) through Resend (resend.com): an API
# key, and a no-reply sender on a domain verified in Resend. Replies to the
# welcome email go to PLATFORM_CONTACT_EMAIL. Without them, emails are written
# to the server log instead of being sent.
# RESEND_API_KEY=
# EMAIL_FROM=Grassroots Club Hub <noreply@grassroots-club-hub.co.uk>

# The privacy policy and terms (/privacy, /terms): who runs the platform
# (a person's or business's legal name) and where questions go (also where
# replies to the welcome email go).
# PLATFORM_OPERATOR=Jane Smith trading as Grassroots Club Hub
# PLATFORM_CONTACT_EMAIL=hello@grassroots-club-hub.co.uk

# The password for the platform admin page (/platform/admin) on the root
# domain: every club, password resets and deleting a club. 12+ characters.
# PLATFORM_ADMIN_KEY=

# Nightly backups (lib/backup.ts) are kept for 7 days. Best in a second Upstash
# database — its REST URL and token here; without them they go in the main one.
# BACKUP_KV_REST_API_URL=
# BACKUP_KV_REST_API_TOKEN=

# Error reports to Sentry (sentry.io → a Next.js project → its DSN). Passwords
# and personal details are stripped first (lib/sentryScrub.ts).
# SENTRY_DSN=
