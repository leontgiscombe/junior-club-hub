<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- passkeys (Face ID sign-in) and links to the hub opening in the app; the
	     site serves the matching /.well-known/apple-app-site-association -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:grassroots-club-hub.co.uk</string>
		<string>applinks:grassroots-club-hub.co.uk</string>
		<string>applinks:*.grassroots-club-hub.co.uk</string>
	</array>
</dict>
</plist>
